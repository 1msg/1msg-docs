              "conversationId": "d94a047f-5984-42af-9f89-0f26c7e70ef1",
              "channelId": "QAF261225002",
              "status": "CLOSED",
              "previousStatus": "OPEN",
              "actorUserId": "b2bb82f0-2253-4e05-b955-a21f3d699caa"
            }
          }
        },
        "required": [
          "type",
          "description",
          "example"
        ]
      },
      "InboxWebhookEnvelopeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Delivery id. Also sent as the X-1msg-Delivery header."
          },
          "type": {
            "type": "string",
            "example": "inbox.conversation.status_changed",
            "description": "Event name. Also sent as the X-1msg-Event header."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "data": {
            "type": "object",
            "additionalProperties": true,
            "description": "Event fields. Shape depends on type. See events[].example on GET /inbox/webhook."
          }
        },
        "required": [
          "id",
          "type",
          "createdAt",
          "data"
        ]
      },
