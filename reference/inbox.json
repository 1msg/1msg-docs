          },
          "type": {
            "type": "string"
          },
          "direction": {
            "type": "string",
            "enum": [
              "INBOUND",
              "OUTBOUND"
            ]
          },
          "contactName": {
            "type": "string"
          },
          "contactPhone": {
            "type": "string"
          },
          "mediaUrl": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "content",
          "type",
          "direction"
        ]
      }
    }
  }
