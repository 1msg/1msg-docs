            "type": "string"
          },
          "channelId": {
            "type": "string"
          },
          "direction": {
            "type": "string",
            "enum": [
              "INBOUND",
              "OUTBOUND"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "TEXT",
              "IMAGE",
              "VIDEO",
              "AUDIO",
              "DOCUMENT",
              "LOCATION",
              "LOCATION_REQUEST",
              "CONTACT",
              "TEMPLATE",
              "SYSTEM",
              "NOTE"
            ],
            "description": "SYSTEM is an inbox event (status, assignee, block, title), not a chat message."
          },
          "content": {
            "type": "string"
          },
          "mediaUrl": {
            "type": "string",
            "nullable": true
          },
          "mediaType": {
            "type": "string",
            "nullable": true
          },
          "fileName": {
            "type": "string",
            "nullable": true
          },
          "fileSize": {
            "type": "number",
            "nullable": true
          },
          "mediaDuration": {
            "type": "number",
            "nullable": true
          },
          "thumbnailUrl": {
            "type": "string",
            "nullable": true
          },
          "templateName": {
            "type": "string",
            "nullable": true
          },
          "templateLanguage": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "SENT",
              "DELIVERED",
              "READ",
              "FAILED"
            ]
          },
          "externalId": {
            "type": "string",
            "nullable": true,
            "description": "Channel message id."
          },
          "sentAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "deliveredAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "readAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "systemEventSource": {
            "type": "string",
            "description": "Set on SYSTEM events started by an operator."
          },
          "systemEventOperatorName": {
            "type": "string"
          },
          "systemEventOperatorEmail": {
            "type": "string"
          },
          "assignmentEvent": {
            "$ref": "#/components/schemas/InboxAssignmentEventDto"
          },
          "author": {
            "nullable": true,
            "description": "User who sent an outbound message.",
            "allOf": [
              {
                "$ref": "#/components/schemas/InboxUserDto"
              }
            ]
          },
          "quotedMessage": {
            "$ref": "#/components/schemas/InboxQuotedMessageDto"
          },
          "latitude": {
            "type": "number",
            "description": "Set when type is LOCATION."
          },
          "longitude": {
            "type": "number",
            "description": "Set when type is LOCATION."
          }
        },
        "required": [
          "id",
          "conversationId",
          "channelId",
          "direction",
          "type",
          "content",
          "status",
          "createdAt"
        ]
      },
      "InboxWebhookEventExampleDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
